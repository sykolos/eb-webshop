APP_NAME="Electrobusiness Staging"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://ebtest.dekor26.hu

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=electrobusiness_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_COOKIE=electrobusiness_staging_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_DRIVER=file
CACHE_PREFIX=electrobusiness_staging
QUEUE_CONNECTION=sync

STAGING_ACCESS_USER=
# Use a password_hash() value, single-quoted to preserve dollar signs.
STAGING_ACCESS_PASSWORD_HASH=
# Only a dedicated test mailbox. Missing/invalid sink blocks all Laravel mail.
STAGING_MAIL_TO=
MAIL_MAILER=log
MAIL_FROM_ADDRESS=staging@example.test
MAIL_FROM_NAME="Electrobusiness Staging"
LOG_CHANNEL=daily
