APP_NAME="ElectroBusiness"
APP_ENV=develop
APP_KEY=base64:CHANGE_ME_GENERATE_ON_SERVER_OR_COPY_EXISTING_KEY
APP_DEBUG=false
APP_URL=https://CHANGE_ME_SUBDOMAIN_URL
ASSET_URL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME_DATABASE
DB_USERNAME=CHANGE_ME_USERNAME
DB_PASSWORD=CHANGE_ME_PASSWORD

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=525600
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=

MAIL_MAILER=smtp
MAIL_HOST=mail.electrobusiness.hu
MAIL_PORT=465
MAIL_USERNAME=noreply@electrobusiness.hu
MAIL_PASSWORD=CHANGE_ME_MAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@electrobusiness.hu
MAIL_FROM_NAME="ElectroBusiness"
